---
import ProfilePage from "@/layouts/ProfilePage.astro"
import entries from "@/data/journey.json"
interface JourneyEntry {
  date: string
  title: string
  description?: string
  links?: { label: string; href: string }[]
}
const journey: JourneyEntry[] = entries
const dates = [...journey].sort((a, b) => b.date.localeCompare(a.date))
const years = [...new Set(dates.map(entry => entry.date.slice(0, 4)))]
---
<ProfilePage title="个人经历" english="Timeline" description="按年份记录的项目和经历。">
  {dates.length === 0 && <p class="text-muted-foreground">暂无经历记录。</p>}
  {years.map(year => (
    <section class="mb-12">
      <h2 class="mb-5 font-mono text-2xl">{year}</h2>
      <ol class="ml-2 border-l border-border">
        {dates.filter(entry => entry.date.startsWith(year)).map(entry => (
          <li class="relative pl-7 pb-7">
            <span aria-hidden="true" class="absolute -left-1 top-2 size-2 rounded-full bg-primary"></span>
            <time datetime={entry.date} class="font-mono text-sm text-muted-foreground">{entry.date.slice(5)}</time>
            <h3 class="mt-2 font-serif text-2xl font-semibold">{entry.title}</h3>
            <p class="mt-3 leading-7 text-content-secondary">{entry.description}</p>
            <div class="mt-4 flex gap-5">{entry.links?.map(link => <a class="text-sm text-primary underline underline-offset-4" href={link.href}>{link.label}</a>)}</div>
          </li>
        ))}
      </ol>
    </section>
  ))}
</ProfilePage>
