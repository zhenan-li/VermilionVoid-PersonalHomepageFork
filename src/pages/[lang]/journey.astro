---
import ProfilePage from "@/layouts/ProfilePage.astro"
import JourneyTimeline from "@/components/JourneyTimeline.astro"
import entries from "@/data/journey.json"
import { languagePaths, routeLocale } from "@/data/languages"
import { msg } from "@/lib/ui"

export const getStaticPaths = languagePaths
const lang = routeLocale(Astro.params.lang)
---
<ProfilePage title={msg(lang, "个人经历")} english="Timeline" description={lang === "en" ? "Milestones and projects by year." : "按年份记录的项目和经历。"}>
  {entries.length > 0 ? <JourneyTimeline entries={entries} /> : (
    <div class="space-y-3">
      <p class="text-muted-foreground">{msg(lang, "暂无经历记录。")}</p>
      <a class="text-primary underline underline-offset-4" href={`/${lang}/journey/demo/`}>
        {lang === "en" ? "View the example timeline" : "查看示例时间线"}
      </a>
    </div>
  )}
</ProfilePage>
