---
import { languagePaths, routeLocale } from "@/data/languages"
export const getStaticPaths = languagePaths
const lang = routeLocale(Astro.params.lang)
import BaseLayout from "@/layouts/BaseLayout.astro"
import Timeline from "@/components/Timeline.astro"
import SiteHeader from "@/components/site-header.astro"
import { Footer } from "@/components/footer"
import { editions } from "@/lib/editions"

const title = lang === "en" ? "Writing archive" : "文章归档"
const description = title
const posts = await editions(lang, true)

// 转换为时间线所需的简化数据
const timelineItems = posts.map(({ key, post }) => ({
  slug: key,
  title: post.data.title,
  date: post.data.published.toLocaleDateString("sv-SE", { timeZone: "Asia/Shanghai" }),
}))
---

<BaseLayout {title} {description} fontProfile="interface">
  <div class="min-h-screen bg-background dark:bg-surface-subtle">
    <SiteHeader />
    <main class="pt-24">
      <Timeline items={timelineItems} />
    </main>
    <Footer {lang} />
  </div>
</BaseLayout>
