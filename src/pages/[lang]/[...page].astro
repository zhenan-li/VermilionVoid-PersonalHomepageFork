---
import BaseLayout from "@/layouts/BaseLayout.astro"
import { ArticleList } from "@/components/article-list"
import { Footer } from "@/components/footer"
import SiteHeader from "@/components/site-header.astro"
import { Hero } from "@/components/hero"
import { PAGE_SIZE } from "@/lib/constants"
import { buildSidebarMeta, toPostMeta } from "@/lib/posts"

import { languages, siteName, siteDescription, type Locale } from "@/data/languages"
import { editions } from "@/lib/editions"
export async function getStaticPaths() {
  const paths = []
  for (const lang of languages) {
    const posts = await editions(lang)
    const pages = Math.max(1, Math.ceil(posts.length / PAGE_SIZE))
    for (let page = 1; page <= pages; page++) {
      paths.push({ params: { lang, page: page === 1 ? undefined : String(page) }, props: { lang, page } })
    }
  }
  return paths
}
const { lang, page } = Astro.props as { lang: Locale; page: number }
const title = siteName[lang]
const description = siteDescription[lang]
const allArticles = (await editions(lang)).map(({ key, post }) => ({ ...toPostMeta(post, lang), slug: key }))
const sidebarMeta = buildSidebarMeta(allArticles, lang)
---

<BaseLayout {title} {description} fontProfile="interface">
  <div class="min-h-screen bg-background dark:bg-surface-subtle">
    <SiteHeader />
    <main>
      {page === 1 && <Hero {lang} client:idle />}
      <section id="home-main" class:list={["scroll-mt-24", page > 1 && "pt-24"]}>
        <ArticleList lang={lang}
          client:visible
          articles={allArticles}
          title={lang === "en" ? "All posts" : "全部文章"}
          showViewAll={false}
          pagination={{ currentPage: page, pageSize: PAGE_SIZE, basePath: "/" + lang + "/" }}
          sidebarCategories={sidebarMeta.categories}
          sidebarTags={sidebarMeta.tags}
        />
      </section>
    </main>
    <Footer {lang} />
  </div>
</BaseLayout>
