---
import { getSortedPosts } from "@/lib/posts"
import { articleKey, articleLanguage } from "@/lib/editions"
export async function getStaticPaths() {
  return (await getSortedPosts()).map(post => ({
    params: { slug: post.id }, props: { href: "/" + articleLanguage(post) + "/posts/" + articleKey(post) + "/" }
  }))
}
return Astro.redirect(Astro.props.href)
---
