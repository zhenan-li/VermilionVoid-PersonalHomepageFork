---
import { defaultLocale, siteName } from "@/data/languages"
import { profile } from "@/data/profile"
import { rssHref } from "@/lib/site-settings"
---
<!doctype html><html lang={defaultLocale}><head><meta charset="utf-8" /><title>Personal homepage</title>
<link rel="icon" href={profile.avatar.trim() || "/mark.png"} />
<link rel="alternate" type="application/rss+xml" title={siteName[defaultLocale]} href={rssHref(defaultLocale)} />
<script is:inline define:vars={{defaultLocale}}>
  const saved = document.cookie.match(/(?:^|; )site_lang=(en|zh)(?:;|$)/)?.[1]
  location.replace("/" + (saved || defaultLocale) + "/" + location.search + location.hash)
</script><noscript><meta http-equiv="refresh" content={"0;url=/" + defaultLocale + "/"} /></noscript></head><body><a href="/en/" lang="en">English</a> · <a href="/zh/" lang="zh">中文</a></body></html>
