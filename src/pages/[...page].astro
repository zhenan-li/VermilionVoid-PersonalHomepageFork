---
import type { GetStaticPaths } from "astro"
import { PAGE_SIZE } from "@/lib/constants"
import { defaultLocale } from "@/data/languages"
import { editions } from "@/lib/editions"
export const getStaticPaths = (async () => Array.from(
  { length: Math.max(0, Math.ceil((await editions(defaultLocale)).length / PAGE_SIZE) - 1) },
  (_, i) => ({ params: { page: String(i + 2) } })
)) satisfies GetStaticPaths
return Astro.redirect("/" + defaultLocale + "/" + Astro.params.page + "/")
---
