---
import { localText, localizedLink, routeLocale } from "@/data/languages"
import { groupJourney, type JourneyEntry } from "@/lib/journey"

interface Props {
  entries: JourneyEntry[]
}
const { entries } = Astro.props
const lang = routeLocale(Astro.params.lang)
const years = groupJourney(entries)
const dateFormat = new Intl.DateTimeFormat(lang === "en" ? "en-US" : "zh-CN", { year: "numeric", month: "short", day: "numeric", timeZone: "UTC" })
const format = (date: string) => dateFormat.format(new Date(date + "T00:00:00Z"))
---

{years.map(([year, events]) => (
  <section class="mb-12">
    <h2 class="mb-5 font-mono text-2xl">{year}</h2>
    <ol class="ml-2 border-l border-border">
      {events.map(event => (
        <li id={event.id} class="relative scroll-mt-24 pl-7 pb-7">
          <span aria-hidden="true" class="absolute -left-1 top-2 size-2 rounded-full bg-primary"></span>
          <p class="font-mono text-sm text-muted-foreground">
            <time datetime={event.date}>{format(event.date)}</time>
            {event.end && <> – {event.end === "ongoing" ? (lang === "zh" ? "至今" : "present") : <time datetime={event.end}>{format(event.end)}</time>}</>}
          </p>
          <h3 class="mt-2 font-serif text-2xl font-semibold">{localText(event.title, lang)}</h3>
          {event.description && <p class="mt-3 leading-7 text-content-secondary">{localText(event.description, lang)}</p>}
          {event.links && event.links.length > 0 && <div class="mt-4 flex gap-5">{event.links.map(link =>
            <a class="text-sm text-primary underline underline-offset-4" href={localizedLink(link.href,lang)}>{localText(link.label,lang)}</a>
          )}</div>}
        </li>
      ))}
    </ol>
  </section>
))}
